PORT=8787
APP_ORIGIN=http://localhost:5173

# LiveKit Cloud project credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Inference models used by the worker
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_LLM_MODEL=openai/gpt-4.1-mini
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=Katie

# Tavus LiveKit avatar (PAL must use LiveKit transport and echo pipeline mode)
TAVUS_API_KEY=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=
# New Tavus naming accepted by the LiveKit plugin; optional aliases for the above.
TAVUS_FACE_ID=
TAVUS_PAL_ID=

# Browser-visible API origin; this is not a secret.
VITE_API_URL=http://localhost:8787
